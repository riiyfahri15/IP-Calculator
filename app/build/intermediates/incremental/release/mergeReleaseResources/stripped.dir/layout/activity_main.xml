<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".MainActivity">

    <!-- ══════════════════════════════════════════
         HEADER
    ══════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Hidden toolbar for ActionBar support -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Icon + Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_network"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="IP Network icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP CALCULATOR"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:letterSpacing="0.06"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subnet &amp; Address Tool"
                        android:textSize="12sp"
                        android:textColor="#BBDEFB"
                        android:letterSpacing="0.02" />

                </LinearLayout>

                <!-- Dark / Light mode toggle button -->
                <ImageView
                    android:id="@+id/btnThemeToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_dark_mode"
                    android:background="@drawable/bg_theme_toggle"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Toggle dark/light mode" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════════
         SCROLLABLE CONTENT
    ══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- ══════════════════════════════════════════
                 SEGMENTED BUTTON
            ══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_segment_container"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnIPv4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="IPv4"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:background="@drawable/bg_segment_selected"
                    android:textColor="@color/segment_selected_text"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnIPv6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="IPv6"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:letterSpacing="0.05"
                    android:background="@drawable/bg_segment_unselected"
                    android:textColor="@color/segment_unselected_text"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- ══════════════════════════════════════════
                 INPUT CARD
            ══════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INPUT"
                        android:textSize="10sp"
                        android:textColor="@color/text_accent"
                        android:textAllCaps="true"
                        android:letterSpacing="0.2"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="14dp" />

                    <!-- ── IPv4 inputs ── -->
                    <LinearLayout
                        android:id="@+id/layoutIPv4Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilIpAddress"
                            style="@style/AppTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="IP Address"
                            android:layout_marginBottom="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etIpAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number|numberDecimal"
                                android:digits="0123456789."
                                android:singleLine="true"
                                android:maxLength="15"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:imeOptions="actionNext" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilIpv4Prefix"
                            style="@style/AppTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Prefix Length / CIDR  (0 – 32)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etIpv4Prefix"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="2"
                                android:singleLine="true"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:imeOptions="actionDone" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- ── IPv6 inputs ── -->
                    <LinearLayout
                        android:id="@+id/layoutIPv6Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilIpv6Address"
                            style="@style/AppTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="IPv6 Address"
                            android:layout_marginBottom="14dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etIpv6Address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:digits="0123456789abcdefABCDEF:"
                                android:singleLine="true"
                                android:maxLength="39"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:imeOptions="actionNext" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPrefixLength"
                            style="@style/AppTextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Prefix Length / CIDR  (0 – 128)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPrefixLength"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3"
                                android:singleLine="true"
                                android:fontFamily="monospace"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:imeOptions="actionDone" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════
                 CALCULATE BUTTON
            ══════════════════════════════════════════ -->
            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:text="CALCULATE"
                android:background="@drawable/bg_calculate_button"
                android:textColor="@color/btn_text_color"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:textAllCaps="true"
                android:elevation="4dp"
                android:stateListAnimator="@null" />

            <!-- ══════════════════════════════════════════
                 RESULT CARD
            ══════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/bg_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Result title + dot -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RESULT"
                            android:textSize="10sp"
                            android:textColor="@color/text_accent"
                            android:textAllCaps="true"
                            android:letterSpacing="0.2"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:id="@+id/dotIndicator"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_inactive" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginBottom="16dp"
                        android:layout_marginTop="8dp" />

                    <!-- IPv4 result rows -->
                    <LinearLayout
                        android:id="@+id/layoutIPv4Results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include android:id="@+id/rowNetworkId"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowBroadcast"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowSubnetMask"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowWildcard"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowUsableHosts"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowFirstHost"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowLastHost"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowCidr"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- IPv6 result rows -->
                    <LinearLayout
                        android:id="@+id/layoutIPv6Results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include android:id="@+id/rowExpanded"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowNetworkPrefix"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowAddressRange"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp" />
                        <include android:id="@+id/rowTotalIps"
                            layout="@layout/item_result_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                    </LinearLayout>

                    <!-- Empty state -->
                    <TextView
                        android:id="@+id/tvEmptyResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enter values and press CALCULATE"
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:visibility="visible" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
