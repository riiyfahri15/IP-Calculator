<?xml version="1.0" encoding="utf-8"?>
<!-- Dark mode: deep navy gradient -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D1B3E"
                android:endColor="#0D1117"
                android:angle="180"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle blue tint overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#331565C0"
                android:endColor="#001565C0"
                android:angle="90"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
