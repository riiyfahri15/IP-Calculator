    <color name="dot_active">#2196F3</color>
    <color name="dot_inactive">#1E2D45</color>
    <color name="error_red">#FF5252</color>
    <color name="input_stroke_default">#1E2D45</color>
    <color name="input_stroke_focused">#2196F3</color>
    <color name="nav_bar_color">#0D1117</color>
